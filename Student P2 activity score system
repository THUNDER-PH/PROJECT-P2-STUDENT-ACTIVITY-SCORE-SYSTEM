def calculate_average(score1, score2, score3):
    total = score1 + score2 + score3
    average = total / 3
    return average

student = int(input("How many students? "))

if student < 3:
    student = 3

for i in range(student):
    print("Student", i + 1)

    name = input("Enter your name: ")
    activity1 = int(input("Activity 1: "))
    activity2 = int(input("Activity 2: "))
    activity3 = int(input("Activity 3: "))

    average = calculate_average(activity1, activity2, activity3)

    if average >= 90:
        status = "Excellent"
    elif average >= 80:
        status = "Very Good"
    elif average >= 75:
        status = "Passed"
    else:
        status = "Failed"

    print("Name:", name)
    print("Activity 1:", activity1)
    print("Activity 2:", activity2)
    print("Activity 3:", activity3)
    print("Average:", round(average, 2))
    print("Status:", status)
